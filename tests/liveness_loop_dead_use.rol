proc example(x: u32) {
    // Deleting unused must also remove x's liveness around the back edge.
    let i: u32 = 0;
    loop {
        let unused = x + 1;
        i = i + 1;
        println("effect");
        if i > 2 {
            break;
        }
    }
}

proc main() {
    example(42);
}
