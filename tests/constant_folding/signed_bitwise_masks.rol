proc masks(x: i64) {
   println(int_to_string(x & I64_MAX));
   println(int_to_string(I64_MAX & x));
   println(int_to_string(x | I64_MAX));
   println(int_to_string(I64_MAX | x));
}

proc main() {
   masks(-1);
   println(int_to_string((-1 & I8_MAX) as i64));
   println(int_to_string((-1 | I8_MAX) as i64));
}
__END__
